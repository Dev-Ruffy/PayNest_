# ------------------------------------------------------------
# PayNest Backend — Environment Variables
# Copy this file to .env and fill in real values.
# ------------------------------------------------------------

NODE_ENV=development
PORT=4000

# PostgreSQL connection string (Render / Railway / local)
DATABASE_URL="postgresql://paynest_user:paynest_password@localhost:5432/paynest?schema=public"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000"

# Nodemailer (SMTP) — e.g. Gmail App Password, SendGrid SMTP, Mailgun, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"
MAIL_FROM="PayNest <no-reply@paynest.app>"

# 32+ char secret used to AES-encrypt student PINs for the Admin "view PIN"
# recovery feature. Generate with: openssl rand -base64 32
PIN_ENCRYPTION_KEY="replace-with-a-random-32-plus-character-secret"

# Developer account (bootstraps the single super-admin)
DEVELOPER_EMAIL="developer@paynest.app"
DEVELOPER_PASSCODE="827589"
DEVELOPER_NOTIFY_EMAIL="rufaimuizz@gmail.com"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Cloudinary (future-ready, optional)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
